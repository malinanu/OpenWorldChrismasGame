# Copy to .env on the server (never commit it). See deploy/CLOUDPANEL.md.
PORT=3100
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=frostvale
DB_USER=frostvale
DB_PASSWORD=change-me
# email = email + password sign-in; phone = phone number + SMS code (production)
AUTH_MODE=email
# console = codes are written to the server log (staging); the local gateway adapter comes later
SMS_PROVIDER=console
SESSION_DAYS=30
# Folder with the built game (dist/) when this server also serves the site (CloudPanel Node.js site)
# STATIC_DIR=/home/<user>/htdocs/<domain>
# Only for local development, when Vite serves the game from another port:
# ORIGIN=http://localhost:5173
