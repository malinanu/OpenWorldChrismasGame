{
  "name": "frostvale-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frostvale accounts, leaderboards and multiplayer (REST under /api, WebSocket at /ws).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/index.ts",
    "migrate": "node dist/migrate.js",
    "test": "node --experimental-strip-types --no-warnings --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
